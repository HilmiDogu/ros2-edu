<?xml version="1.0"?>
<!--
  The Moon world: open, wall-less lunar terrain with hills and craters.

  Unlike the original walled arena, the ground is now a 3-D HEIGHTMAP
  (models/ground/heightmap.png, generated by make_heightmap.py): rolling
  hills the rover climbs and real bowl-shaped craters it drives down into.
  There are no boundary walls; the rover roams freely, and the hills and
  scattered boulders are what give the lidar returns and SLAM its features.

  What makes it the Moon:
    * gravity 1.62 m/s^2,
    * a near-black airless sky,
    * grey regolith, applied as the heightmap's surface texture.

  Everything is still local: the heightmap and texture are generated by
  the scripts in models/ground, the rocks are vendored meshes. No network.

  NOTE on realism: low gravity + real slopes means the six-wheel rover can
  slip, struggle on steep grades, or slide in a crater. That is physically
  honest for a rover on the Moon and is the point of the terrain.
-->
<sdf version="1.9">
  <world name="moon">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -1.62</gravity>

    <scene>
      <!-- Low ambient: on an airless body there is no sky light to
           fill the shadows, and a bright ambient also washes the
           stars out of the backdrop. -->
      <ambient>0.12 0.12 0.14 1</ambient>
      <!-- Near-black: the starfield sphere provides the sky now, and
           this only shows through where the dome does not. -->
      <background>0.0 0.0 0.01 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <!-- A LOW sun: 18 degrees above the horizon, azimuth 205.
           <direction> is the way the light travels, so this points down
           and away from a sun sitting behind-left of the spawn point.
           The previous -0.4 0.2 -0.9 put it 64 degrees up -- nearly
           overhead, which flattens the terrain into featureless grey.
           A low sun rakes across the craters and throws long shadows,
           which is both how lunar imagery actually looks and far easier
           to read. It also puts the sun where the rover camera can
           occasionally see it.

           MUST stay consistent with the sun disc in models/skydome: the
           light is invisible and the disc emits nothing, so if they
           disagree the shadows fall away from the visible sun. -->
      <direction>0.862 0.402 -0.309</direction>
    </light>

    <!-- The space backdrop: starfield, Earth and a sun disc. Static,
         collision-free geometry, so the lidar passes through it and the
         SLAM map is unaffected. See models/skydome/model.sdf for why
         this is geometry rather than Gazebo's built-in <sky>. -->
    <include>
      <name>skydome</name>
      <uri>model://skydome</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ===================== Heightmap terrain ====================== -->
    <!-- 40 x 40 m of terrain, 4 m of total vertical range. The heightmap
         image's mid-grey base sits at z=0; craters dip below, hills rise
         above. High friction so the rover can climb (regolith is grippy,
         and low gravity already cuts the available grip). -->
    <!-- Terrain as a MESH, not a heightmap. DART (Gazebo's physics engine)
         collides reliably against a triangle mesh but tunnels through a
         heightmap collision: a light rover in low gravity drove straight
         through the heightmap and fell out of the world. terrain.obj is
         generated from the same heightmap.png by make_terrain_mesh.py, so
         the hills and craters are identical, but the rover now stays on
         the surface. Used for both collision and visual. -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh><uri>model://ground/terrain.obj</uri></mesh>
          </geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh><uri>model://ground/terrain.obj</uri></mesh>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://ground/materials/textures/moon_regolith.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= Rocks =========================
         20 rock meshes scattered across the open terrain; these are
         the lidar's main features now that there are no walls. Each z
         is the terrain surface height at its (x,y), so every rock sits
         seated on the ground rather than floating or buried. -->
    <include><name>rock_a</name><uri>model://rock1</uri>
      <pose>-3.0 2.0 -0.84 0.2 0.1 0.5</pose><scale>0.006 0.006 0.006</scale></include>
    <include><name>rock_b</name><uri>model://rock6</uri>
      <pose>3.5 -2.5 -1.76 0 0.15 0.9</pose><scale>0.0055 0.0055 0.0055</scale></include>
    <include><name>rock_c</name><uri>model://rock1</uri>
      <pose>1.5 3.5 -1.64 0.15 0 0.7</pose><scale>0.005 0.005 0.005</scale></include>
    <include><name>rock_d</name><uri>model://rock6</uri>
      <pose>-2.5 -3.5 -1.05 0.1 0.2 0.3</pose><scale>0.0045 0.0045 0.0045</scale></include>
    <include><name>rock_e</name><uri>model://rock1</uri>
      <pose>5.0 1.0 -0.93 0 0.1 1.2</pose><scale>0.004 0.004 0.004</scale></include>
    <include><name>rock_f</name><uri>model://rock6</uri>
      <pose>-5.0 4.0 -0.58 0.2 0 2.1</pose><scale>0.0038 0.0038 0.0038</scale></include>
    <include><name>rock_g</name><uri>model://rock1</uri>
      <pose>0.5 -5.0 -0.06 0 0.15 0.4</pose><scale>0.0035 0.0035 0.0035</scale></include>
    <include><name>rock_h</name><uri>model://rock6</uri>
      <pose>-6.5 -1.0 -0.65 0.1 0.1 1.7</pose><scale>0.0042 0.0042 0.0042</scale></include>
    <include><name>rock_i</name><uri>model://rock1</uri>
      <pose>6.5 -4.0 -0.32 0 0 0.9</pose><scale>0.003 0.003 0.003</scale></include>
    <include><name>rock_j</name><uri>model://rock6</uri>
      <pose>2.5 5.5 -1.14 0.15 0.1 2.6</pose><scale>0.0032 0.0032 0.0032</scale></include>
    <include><name>rock_k</name><uri>model://rock1</uri>
      <pose>-4.0 -6.0 -0.91 0 0.2 0.2</pose><scale>0.0028 0.0028 0.0028</scale></include>
    <include><name>rock_l</name><uri>model://rock6</uri>
      <pose>4.5 4.5 -0.89 0.1 0 1.1</pose><scale>0.0026 0.0026 0.0026</scale></include>
    <include><name>rock_m</name><uri>model://rock1</uri>
      <pose>7.5 2.5 0.08 0.1 0.1 0.3</pose><scale>0.005 0.005 0.005</scale></include>
    <include><name>rock_n</name><uri>model://rock6</uri>
      <pose>-7.0 2.0 -0.27 0 0.2 1.4</pose><scale>0.0048 0.0048 0.0048</scale></include>
    <include><name>rock_o</name><uri>model://rock1</uri>
      <pose>-1.0 6.5 -1.40 0.2 0 0.6</pose><scale>0.004 0.004 0.004</scale></include>
    <include><name>rock_p</name><uri>model://rock6</uri>
      <pose>3.0 -6.5 0.46 0.1 0.15 2.0</pose><scale>0.0036 0.0036 0.0036</scale></include>
    <include><name>rock_q</name><uri>model://rock1</uri>
      <pose>-6.0 -4.5 -0.72 0 0.1 0.8</pose><scale>0.0033 0.0033 0.0033</scale></include>
    <include><name>rock_r</name><uri>model://rock6</uri>
      <pose>6.0 6.0 -0.32 0.15 0 1.9</pose><scale>0.003 0.003 0.003</scale></include>
    <include><name>rock_s</name><uri>model://rock1</uri>
      <pose>1.0 0.5 -1.50 0 0 0.5</pose><scale>0.0025 0.0025 0.0025</scale></include>
    <include><name>rock_t</name><uri>model://rock6</uri>
      <pose>-2.0 4.5 -1.40 0.1 0.1 1.3</pose><scale>0.0027 0.0027 0.0027</scale></include>

  </world>
</sdf>
