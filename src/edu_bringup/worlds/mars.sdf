<?xml version="1.0"?>
<!--
  The Mars world: open, wall-less Martian terrain with hills and craters.

  The ground is a 3-D HEIGHTMAP (models/ground/heightmap.png, shared with
  the Moon world and generated by make_heightmap.py): rolling hills the
  rover climbs and bowl-shaped craters it drives down into. No boundary
  walls; the rover roams freely, and hills and scattered rocks give the
  lidar returns and SLAM its features.

  What makes it Mars:
    * gravity 3.72 m/s^2,
    * a dusty butterscotch sky,
    * red-brown iron-oxide soil as the heightmap's surface texture.

  All assets are local (generated scripts + vendored rock meshes); no
  network. Real slopes mean the six-wheel rover can slip or struggle on
  steep grades, honest rover behaviour, and the point of the terrain.
-->
<sdf version="1.9">
  <world name="mars">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -3.72</gravity>

    <scene>
      <ambient>0.45 0.35 0.28 1</ambient>
      <background>0.72 0.52 0.36 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 0.88 0.72 1</diffuse>
      <specular>0.25 0.22 0.18 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- ===================== Heightmap terrain ====================== -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>model://ground/heightmap.png</uri>
              <size>40 40 4</size>
              <pos>0 0 -1.8</pos>
            </heightmap>
          </geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>model://ground/heightmap.png</uri>
              <size>40 40 4</size>
              <pos>0 0 -1.8</pos>
              <texture>
                <diffuse>model://ground/materials/textures/mars_soil.png</diffuse>
                <normal>model://ground/materials/textures/mars_soil.png</normal>
                <size>8</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ========================= Rocks ========================= -->
    <include><name>rock_a</name><uri>model://rock1</uri>
      <pose>-3.0 2.0 1.0 0.2 0.1 0.5</pose><scale>0.006 0.006 0.006</scale></include>
    <include><name>rock_b</name><uri>model://rock6</uri>
      <pose>3.5 -2.5 1.0 0 0.15 0.9</pose><scale>0.0055 0.0055 0.0055</scale></include>
    <include><name>rock_c</name><uri>model://rock1</uri>
      <pose>1.5 3.5 1.0 0.15 0 0.7</pose><scale>0.005 0.005 0.005</scale></include>
    <include><name>rock_d</name><uri>model://rock6</uri>
      <pose>-2.5 -3.5 1.0 0.1 0.2 0.3</pose><scale>0.0045 0.0045 0.0045</scale></include>
    <include><name>rock_e</name><uri>model://rock1</uri>
      <pose>5.0 1.0 1.0 0 0.1 1.2</pose><scale>0.004 0.004 0.004</scale></include>
    <include><name>rock_f</name><uri>model://rock6</uri>
      <pose>-5.0 4.0 1.0 0.2 0 2.1</pose><scale>0.0038 0.0038 0.0038</scale></include>
    <include><name>rock_g</name><uri>model://rock1</uri>
      <pose>0.5 -5.0 1.0 0 0.15 0.4</pose><scale>0.0035 0.0035 0.0035</scale></include>
    <include><name>rock_h</name><uri>model://rock6</uri>
      <pose>-6.5 -1.0 1.0 0.1 0.1 1.7</pose><scale>0.0042 0.0042 0.0042</scale></include>
    <include><name>rock_i</name><uri>model://rock1</uri>
      <pose>6.5 -4.0 1.0 0 0 0.9</pose><scale>0.003 0.003 0.003</scale></include>
    <include><name>rock_j</name><uri>model://rock6</uri>
      <pose>2.5 5.5 1.0 0.15 0.1 2.6</pose><scale>0.0032 0.0032 0.0032</scale></include>
    <include><name>rock_k</name><uri>model://rock1</uri>
      <pose>-4.0 -6.0 1.0 0 0.2 0.2</pose><scale>0.0028 0.0028 0.0028</scale></include>
    <include><name>rock_l</name><uri>model://rock6</uri>
      <pose>4.5 4.5 1.0 0.1 0 1.1</pose><scale>0.0026 0.0026 0.0026</scale></include>

  </world>
</sdf>
