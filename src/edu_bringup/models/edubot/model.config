<?xml version="1.0"?>
<model>
  <name>edubot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>DFKI ROS 2 / Gazebo teaching workspace</name>
  </author>
  <description>
    A minimal differential-drive teaching robot: two driven wheels, a
    caster, a 360-degree 2D lidar, a camera and an IMU. Kept deliberately
    small so students can read the whole description in one sitting.
  </description>
</model>
