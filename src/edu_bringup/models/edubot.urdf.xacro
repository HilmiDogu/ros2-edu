<?xml version="1.0"?>
<!--
  EduBot, described a second time - this time in URDF.

  Why twice? Gazebo simulates from the SDF; ROS 2 reasons about the robot
  from the URDF. robot_state_publisher reads this file and broadcasts the
  fixed transforms (base_link -> lidar_link, camera_link, imu_link) plus
  the moving wheel transforms it derives from /joint_states. RViz needs
  those transforms to place sensor data correctly.

  The dimensions here MUST match model.sdf. If you change a wheel radius
  in one file, change it in the other, or the robot RViz draws will drift
  away from the robot Gazebo simulates.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="edubot">

  <!-- Single source of truth for the numbers shared with model.sdf. -->
  <xacro:property name="wheel_radius"    value="0.07"/>
  <xacro:property name="wheel_width"     value="0.04"/>
  <xacro:property name="wheel_separation" value="0.32"/>
  <xacro:property name="base_length"     value="0.4"/>
  <xacro:property name="base_width"      value="0.25"/>
  <xacro:property name="base_height"     value="0.1"/>

  <material name="blue">  <color rgba="0.2 0.45 0.8 1"/></material>
  <material name="dark">  <color rgba="0.2 0.2 0.2 1"/></material>
  <material name="red">   <color rgba="0.8 0.2 0.1 1"/></material>
  <material name="green"> <color rgba="0.1 0.7 0.3 1"/></material>

  <!-- base_footprint sits on the ground directly under base_link. Nav2
       and most navigation tooling expect this frame to exist. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.0302" ixy="0" ixz="0" iyy="0.0708" iyz="0" izz="0.0927"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- One macro, two wheels: reflect is +1 for left, -1 for right. -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.000795" ixy="0" ixz="0" iyy="0.000795" iyz="0" izz="0.00125"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect * wheel_separation / 2} -0.03" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <link name="caster">
    <visual>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1.6e-5" ixy="0" ixz="0" iyy="1.6e-5" iyz="0" izz="1.6e-5"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster"/>
    <origin xyz="-0.15 0 -0.06" rpy="0 0 0"/>
  </joint>

  <!-- Sensor frames. These carry no geometry that matters to physics;
       they exist so sensor data has somewhere to attach in the TF tree. -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="4e-5"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.1 0 0.09" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.06 0.04"/></geometry>
      <material name="green"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.2 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
</robot>
