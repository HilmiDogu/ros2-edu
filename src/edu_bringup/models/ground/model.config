<?xml version="1.0"?>
<!--
  Not a robot: this "model" exists only so the Moon and Mars worlds can
  reach the ground textures under materials/textures/ with a stable
  model://ground/... URI, which Gazebo resolves via GZ_SIM_RESOURCE_PATH.
-->
<model>
  <name>ground</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>DFKI ROS 2 / Gazebo teaching workspace</name>
  </author>
  <description>
    Ground surface textures (Moon regolith, Mars soil) for the space
    worlds. Procedurally generated by make_textures.py; no mesh, no
    download.
  </description>
</model>
