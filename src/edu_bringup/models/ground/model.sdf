<?xml version="1.0"?>
<!--
  Placeholder. The "ground" model is never spawned; it exists only so
  model://ground/materials/textures/... resolves for the Moon and Mars
  world ground planes. An empty static model keeps this a valid SDF.
-->
<sdf version="1.9">
  <model name="ground">
    <static>true</static>
    <link name="link"/>
  </model>
</sdf>
