<?xml version="1.0"?>
<!--
  Perseverance-style rover: a six-wheel planetary rover for teaching.

  This is a drop-in replacement for edubot. It keeps EVERY interface the
  course depends on so that all modules (teleop, odometry, SLAM, the
  example nodes) work without change:

    frames  : base_link, lidar_link, camera_link, imu_link
    topics  : cmd_vel, scan, camera, imu, odom, tf, joint_states
    drive   : gz-sim-diff-drive-system on left_wheel_joint / right_wheel_joint
    wheels  : wheel_radius 0.07, wheel_separation 0.32  (matches rover.urdf.xacro)

  What is different from edubot is only the LOOK:

    * six wheels instead of two + a caster. The two MIDDLE wheels
      (left_wheel / right_wheel) are the driven pair the DiffDrive plugin
      commands and derives odometry from -- exactly the edubot interface.
      The four corner wheels are free-spinning "continuous" joints: they
      carry the rover's weight and give the authentic six-wheel look, but
      they are deliberately NOT driven, so odometry stays as simple and
      correct as the two-wheel case. A fully-articulated rocker-bogie with
      six driven wheels does not map onto the DiffDrive plugin and would
      break odom/SLAM for the course, so we keep the look and skip the
      articulation.

    * a rocker-bogie-style body: a low main chassis with side rails, so it
      reads as a rover rather than a box.

    * a raised sensor mast. camera_link stays a real frame at the top of
      the mast (like Perseverance's Mastcam), and lidar_link stays where
      the modules expect a 2-D scan.

  Everything is still primitive shapes -- no meshes -- so the world loads
  instantly and works with no network, like the rest of this workspace.

  Numbers here MUST match rover.urdf.xacro. Change a wheel radius in one,
  change it in the other, or the rover RViz draws drifts from the rover
  Gazebo simulates.
-->
<sdf version="1.9">
  <model name="rover">
    <pose>0 0 0.12 0 0 0</pose>

    <!-- ===================== Chassis ===================== -->
    <!-- A flat main body. Wider and longer than edubot so six wheels fit
         and it looks like a rover deck. -->
    <link name="base_link">
      <inertial>
        <mass>8.0</mass>
        <!-- Box inertia for 0.6 x 0.4 x 0.12 m at m = 8 kg. -->
        <inertia>
          <ixx>0.1163</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.2496</iyy><iyz>0</iyz>
          <izz>0.3067</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.6 0.4 0.12</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.6 0.4 0.12</size></box></geometry>
        <material>
          <!-- Rover gold/beige, like a thermally wrapped deck. -->
          <ambient>0.55 0.47 0.30 1</ambient>
          <diffuse>0.80 0.68 0.42 1</diffuse>
        </material>
      </visual>
      <!-- A solar-deck-ish top plate, purely cosmetic. -->
      <visual name="deck_visual">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry><box><size>0.5 0.34 0.02</size></box></geometry>
        <material>
          <ambient>0.10 0.12 0.25 1</ambient>
          <diffuse>0.12 0.16 0.35 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ===================== Wheels ====================== -->
    <!-- All six wheels share radius 0.07 and width 0.05. The two middle
         wheels are the driven pair; the four corners spin freely.
         Rotated -pi/2 about X so the cylinder axis lies along Y. -->

    <!-- ---- Driven middle pair: left_wheel / right_wheel ---- -->
    <link name="left_wheel">
      <pose>0 0.24 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00098</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00098</iyy><iyz>0</iyz>
          <izz>0.00147</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <!-- A six-wheel skid steer turns by scrubbing its wheels
             sideways. If that scrub grips, the wheels spin at the
             commanded rate but the rover does not turn; odometry then
             reports a rotation that never happened, SLAM violently
             re-orients the map to match, and the map appears to shear and
             spin around the robot (the exact symptom seen in RViz).

             The fix is NOT just a low mu2 -- without fdir1, ODE picks an
             arbitrary friction axis, so "mu2" is not actually the sideways
             direction and the scrub still grips. fdir1 = 1 0 0 pins the
             first friction direction to the wheel's ROLLING axis, so mu
             (rolling) gives forward traction and mu2 + slip2 (lateral)
             let the wheel slide sideways during a turn. Measured: with
             this, a commanded 0.5 rad/s turn produces a real 0.5 rad/s
             turn (truth == odom); without fdir1 the real turn was ~0.05. -->
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.1</slip2></ode></friction></surface>
      </collision>
      <visual name="left_wheel_visual">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.24 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00098</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00098</iyy><iyz>0</iyz>
          <izz>0.00147</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <!-- A six-wheel skid steer turns by scrubbing its wheels
             sideways. If that scrub grips, the wheels spin at the
             commanded rate but the rover does not turn; odometry then
             reports a rotation that never happened, SLAM violently
             re-orients the map to match, and the map appears to shear and
             spin around the robot (the exact symptom seen in RViz).

             The fix is NOT just a low mu2 -- without fdir1, ODE picks an
             arbitrary friction axis, so "mu2" is not actually the sideways
             direction and the scrub still grips. fdir1 = 1 0 0 pins the
             first friction direction to the wheel's ROLLING axis, so mu
             (rolling) gives forward traction and mu2 + slip2 (lateral)
             let the wheel slide sideways during a turn. Measured: with
             this, a commanded 0.5 rad/s turn produces a real 0.5 rad/s
             turn (truth == odom); without fdir1 the real turn was ~0.05. -->
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.1</slip2></ode></friction></surface>
      </collision>
      <visual name="right_wheel_visual">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
    </link>

    <!-- ---- Free-spinning corner wheels (the six-wheel look) ---- -->
    <link name="front_left_wheel">
      <pose>0.22 0.24 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00098</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00098</iyy><iyz>0</iyz>
          <izz>0.00147</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <!-- A six-wheel skid steer turns by scrubbing its wheels
             sideways. If that scrub grips, the wheels spin at the
             commanded rate but the rover does not turn; odometry then
             reports a rotation that never happened, SLAM violently
             re-orients the map to match, and the map appears to shear and
             spin around the robot (the exact symptom seen in RViz).

             The fix is NOT just a low mu2 -- without fdir1, ODE picks an
             arbitrary friction axis, so "mu2" is not actually the sideways
             direction and the scrub still grips. fdir1 = 1 0 0 pins the
             first friction direction to the wheel's ROLLING axis, so mu
             (rolling) gives forward traction and mu2 + slip2 (lateral)
             let the wheel slide sideways during a turn. Measured: with
             this, a commanded 0.5 rad/s turn produces a real 0.5 rad/s
             turn (truth == odom); without fdir1 the real turn was ~0.05. -->
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.1</slip2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.22 -0.24 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00098</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00098</iyy><iyz>0</iyz>
          <izz>0.00147</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <!-- A six-wheel skid steer turns by scrubbing its wheels
             sideways. If that scrub grips, the wheels spin at the
             commanded rate but the rover does not turn; odometry then
             reports a rotation that never happened, SLAM violently
             re-orients the map to match, and the map appears to shear and
             spin around the robot (the exact symptom seen in RViz).

             The fix is NOT just a low mu2 -- without fdir1, ODE picks an
             arbitrary friction axis, so "mu2" is not actually the sideways
             direction and the scrub still grips. fdir1 = 1 0 0 pins the
             first friction direction to the wheel's ROLLING axis, so mu
             (rolling) gives forward traction and mu2 + slip2 (lateral)
             let the wheel slide sideways during a turn. Measured: with
             this, a commanded 0.5 rad/s turn produces a real 0.5 rad/s
             turn (truth == odom); without fdir1 the real turn was ~0.05. -->
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.1</slip2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.22 0.24 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00098</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00098</iyy><iyz>0</iyz>
          <izz>0.00147</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <!-- A six-wheel skid steer turns by scrubbing its wheels
             sideways. If that scrub grips, the wheels spin at the
             commanded rate but the rover does not turn; odometry then
             reports a rotation that never happened, SLAM violently
             re-orients the map to match, and the map appears to shear and
             spin around the robot (the exact symptom seen in RViz).

             The fix is NOT just a low mu2 -- without fdir1, ODE picks an
             arbitrary friction axis, so "mu2" is not actually the sideways
             direction and the scrub still grips. fdir1 = 1 0 0 pins the
             first friction direction to the wheel's ROLLING axis, so mu
             (rolling) gives forward traction and mu2 + slip2 (lateral)
             let the wheel slide sideways during a turn. Measured: with
             this, a commanded 0.5 rad/s turn produces a real 0.5 rad/s
             turn (truth == odom); without fdir1 the real turn was ~0.05. -->
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.1</slip2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.22 -0.24 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00098</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00098</iyy><iyz>0</iyz>
          <izz>0.00147</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <!-- A six-wheel skid steer turns by scrubbing its wheels
             sideways. If that scrub grips, the wheels spin at the
             commanded rate but the rover does not turn; odometry then
             reports a rotation that never happened, SLAM violently
             re-orients the map to match, and the map appears to shear and
             spin around the robot (the exact symptom seen in RViz).

             The fix is NOT just a low mu2 -- without fdir1, ODE picks an
             arbitrary friction axis, so "mu2" is not actually the sideways
             direction and the scrub still grips. fdir1 = 1 0 0 pins the
             first friction direction to the wheel's ROLLING axis, so mu
             (rolling) gives forward traction and mu2 + slip2 (lateral)
             let the wheel slide sideways during a turn. Measured: with
             this, a commanded 0.5 rad/s turn produces a real 0.5 rad/s
             turn (truth == odom); without fdir1 the real turn was ~0.05. -->
        <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.1</slip2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 -1.5707 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
    </link>

    <!-- ---- Wheel joints ---- -->
    <!-- The driven pair. -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <!-- The four free-spinning corner wheels. Same axis, no plugin drives
         them; they roll under the rover's weight. -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ===================== Sensor mast ===================== -->
    <!-- A vertical post carrying the camera up high, like a rover mast.
         Purely structural; it has its own link so it moves with the body. -->
    <link name="mast_link">
      <pose>-0.12 0 0.18 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0011</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0011</iyy><iyz>0</iyz>
          <izz>2e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.02</radius><length>0.26</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.02</radius><length>0.26</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
      </visual>
    </link>
    <joint name="mast_joint" type="fixed">
      <parent>base_link</parent><child>mast_link</child>
    </joint>

    <!-- ===================== Sensors ===================== -->
    <!-- 2-D lidar, kept low on the deck so it produces the flat scan the
         SLAM module expects. Same topic/frame/config as edubot. -->
    <link name="lidar_link">
      <!-- z=0.42 puts the scan plane ABOVE everything on the rover. It
           used to sit at z=0.11, inside the mast's own span, so a large
           part of every scan was a fixed return off the rover itself.
           A scan matcher cannot localise against geometry that never
           moves relative to the sensor: it kept finding inconsistent
           orientations and spun the whole map around the rover. Nothing
           may intrude on a 360-degree scan plane. -->
      <pose>0.15 0 0.42 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>4e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4e-5</iyy><iyz>0</iyz>
          <izz>4e-5</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
        <material><diffuse>0.8 0.2 0.1 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>

    <!-- Mastcam: mounted on top of the mast, looking forward. Same topic
         and frame name as edubot so the image bridge is unchanged. -->
    <link name="camera_link">
      <pose>-0.10 0 0.33 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-5</iyy><iyz>0</iyz>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.04 0.10 0.04</size></box></geometry>
        <material><diffuse>0.1 0.7 0.3 1</diffuse></material>
      </visual>
      <sensor name="camera" type="camera">
        <topic>camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent><child>camera_link</child>
    </joint>

    <link name="imu_link">
      <pose>0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="imu" type="imu">
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent><child>imu_link</child>
    </joint>

    <!-- ===================== Plugins ===================== -->
    <!-- Six-wheel skid steer. DiffDrive accepts several <left_joint> /
         <right_joint> entries and drives them together, so ALL THREE
         wheels on each side are powered. This is the fix for a six-wheel
         rover: with only the middle pair driven, the four un-powered
         corner wheels grip the ground and hold the rover still while the
         driven wheels spin in place. Driving every wheel makes it move.
         Odometry is still the clean differential model computed from the
         wheel geometry, so the odom/tf interface is unchanged. -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.48</wheel_separation>
      <wheel_radius>0.07</wheel_radius>
      <!-- 100 Hz, not 30. This sets the rate of BOTH /odom and the
           odom -> base_footprint transform on /tf. The lidar stamps
           each scan with the simulation time it was taken, and RViz
           (and SLAM) must look up that exact stamp. At 30 Hz the
           measured transform stream actually arrived near 21 Hz,
           leaving gaps of up to 130 ms -- longer than the 100 ms
           between scans. Over half of all scans then failed their
           lookup with "extrapolation into the future" and RViz drew
           them collapsed at the origin. Publishing faster than the
           sensor keeps a transform always available just ahead of
           every scan stamp. -->
      <odom_publish_frequency>100</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <!-- Publish odom -> base_footprint, NOT odom -> base_link. The URDF
           already owns base_footprint -> base_link, and a TF frame may
           have only one parent. If DiffDrive also parents base_link to
           odom, base_link has two parents, the tree splits, and the SLAM
           map (map -> odom -> base_footprint) cannot be tied to the
           robot -- the symptom is a map that slides with the robot as it
           drives. Parenting base_footprint here keeps a single chain:
           map -> odom -> base_footprint -> base_link -> sensors. -->
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>2.0</max_linear_acceleration>
    </plugin>

    <!-- Reports every wheel joint angle so RViz animates all six wheels. -->

    <!-- GROUND TRUTH. DiffDrive's odometry above is computed from wheel
         rotation, so it drifts: spin the wheels against a wall and it
         happily reports metres of travel the robot never made. This
         plugin instead reports the pose Gazebo actually simulates.
         Publishing both is the point -- RViz can draw the robot's belief
         and its true position side by side, and the gap between them IS
         the lesson of module 03. Topic and frames are kept distinct so
         nothing downstream confuses the two. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint_truth</robot_base_frame>
      <odom_topic>odom_truth</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <!-- Without an explicit rate this plugin publishes once per physics
           step -- 1000 Hz at a 1 ms step, measured at 919 Hz. Every one of
           those messages makes robot_state_publisher republish the whole
           TF tree, so /tf is flooded with wheel transforms stamped far
           ahead of the 30 Hz odom -> base_footprint the bridge delivers.
           TF2 then interpolates the robot's pose against timestamps it has
           no odometry for, and the pose jumps metres between consecutive
           lookups: the laser scan is drawn at those bogus poses and
           visibly collapses toward the robot. 50 Hz is plenty for
           animating six wheels and keeps TF consistent. -->
      <update_rate>50</update_rate>
    </plugin>
  </model>
</sdf>
