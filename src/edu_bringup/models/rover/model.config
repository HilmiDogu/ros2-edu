<?xml version="1.0"?>
<model>
  <name>rover</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>DFKI ROS 2 / Gazebo teaching workspace</name>
  </author>
  <description>
    A Perseverance-style six-wheel planetary rover. A drop-in replacement
    for edubot that keeps the same frames, topics and differential-drive
    interface: the two middle wheels are driven, the four corner wheels
    spin freely for the authentic six-wheel look. Carries the same 360
    degree 2D lidar, a mast camera and an IMU.
  </description>
</model>
