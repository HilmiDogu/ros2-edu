<?xml version="1.0"?>
<model>
  <name>skydome</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>DFKI ROS 2 / Gazebo teaching workspace</name></author>
  <description>
    A starfield sphere enclosing the world, plus an Earth disc. Real
    geometry rather than a GUI sky, so the rover's camera sees the same
    sky the 3-D view does.
  </description>
</model>
